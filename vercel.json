{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/cameras/(.*)",
      "dest": "/api/cameras.js?id=$1"
    },
    {
      "src": "/api/cameras",
      "dest": "/api/cameras.js"
    },
    {
      "src": "/api/lenses/(.*)",
      "dest": "/api/lenses.js?id=$1"
    },
    {
      "src": "/api/lenses",
      "dest": "/api/lenses.js"
    },
    {
      "src": "/api/guides/(.*)",
      "dest": "/api/guides.js?id=$1"
    },
    {
      "src": "/api/guides",
      "dest": "/api/guides.js"
    },
    {
      "src": "/api/profile",
      "dest": "/api/profile.js"
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
